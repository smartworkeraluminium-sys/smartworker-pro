                    Label:
                        text: "Domal Silver Anodized:"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_dm_anod
                        text: "295"
                    Label:
                        text: "Domal Powder Coated:"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_dm_powder
                        text: "310"
                    Label:
                        text: "Domal Wooden Finish:"
                        bold: True
                        color: 0.8, 0.4, 0.1, 1
                    NumInput:

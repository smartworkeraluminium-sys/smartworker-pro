            height: '65dp'
            padding: '10dp'
            canvas.before:
                Color:
                    rgba: 0.7, 0.3, 0.1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, 20, 20]
            Button:
                text: "< Back"
                bold: True
                size_hint_x: 0.25
                background_normal: ''
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: 0.8, 0.1, 0.1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.manager.current = 'home'
            Label:
                text: "DOOR OPTION"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.75
                
        GridLayout:
            cols: 2
            size_hint_y: None
            height: '180dp'
            padding: '10dp'
            spacing: '10dp'
            Label:
                text: "Door Type:"
                color: 0,0,0,1
            Spinner:
                id: d_master_type
                text: "Standard Door"
                values: ["Standard Door", "Floor Spring Door", "Top Hung Door", "Domal System Door"]
            Label:
                text: "Input Unit:"
                color: 0,0,0,1
            Spinner:
                id: d_master_unit
                text: "Inch"
                values: ["Inch", "Millimeter"]
            Label:
                text: "Total Height (H):"
                color: 0,0,0,1
            NumInput:
                id: d_master_h
            Label:
                text: "Total Width (W):"
                color: 0,0,0,1
            NumInput:
                id: d_master_w
                
        BoxLayout:
            size_hint_y: None
            height: '55dp'
            padding: [10, 5, 10, 5]
            spacing: '10dp'
            PremiumBtn:
                text: "CLEAR"
                size_hint_x: 0.3
                bg_color: 0.8, 0.2, 0.2, 1
                on_release: root.clear_all()
            PremiumBtn:
                text: "+ CALCULATE"
                size_hint_x: 0.7
                bg_color: 0.7, 0.3, 0.1, 1
                on_release: root.calculate_door()
                
        BoxLayout:
            size_hint_y: None
            height: '55dp'
            padding: [10, 5, 10, 5]
            spacing: '10dp'
            PremiumBtn:
                text: "SAVE"
                bg_color: 0.2, 0.7, 0.3, 1
                on_release: root.save_data(self)
            PremiumBtn:
                text: "CUT PDF"
                bg_color: 0.6, 0.3, 0.6, 1
                on_release: root.export_full(self)
            PremiumBtn:
                text: "GLASS PDF"
                bg_color: 0.1, 0.6, 0.8, 1
                on_release: root.export_glass(self)
                
        ScrollView:
            size_hint_y: 1
            padding: '10dp'
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '10dp'
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.98, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "CUTTING SIZES:"
                    size_hint_y: None
                    height: '25dp'
                    color: 0.7, 0.3, 0.1, 1
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                TextInput:
                    id: d_master_out
                    readonly: True
                    use_bubble: False
                    use_handles: False
                    size_hint_y: None
                    height: max(self.minimum_height, dp(250))
                Label:
                    text: "MATERIAL PURCHASE (AUTO-UPDATED):"
                    size_hint_y: None
                    height: '25dp'
                    color: 0.2, 0.7, 0.3, 1
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                TextInput:
                    id: d_master_mat_out
                    readonly: True
                    use_bubble: False
                    use_handles: False
                    size_hint_y: None
                    height: max(self.minimum_height, dp(250))


                id: domal_handle_hw
                text: "27x65 mm"
                values: ["27x60 mm", "27x65 mm", "28x65 mm", "26x66 mm", "27x70 mm", "32x72 mm", "35x75 mm", "37x82 mm", "45x85 mm"]
            Label:
                text: "Track & Sash Type:"
                color: 0,0,0,1
            Spinner:
                id: combo_type_cut
                text: "2-Track (2-Sash)"
                values: ["2-Track (2-Sash)", "3-Track (3-Sash)", "4-Track (4-Sash)", "2-Track (Center Open)"]
            Label:
                text: "Input Unit:"
                color: 0,0,0,1
            Spinner:
                id: combo_unit_cut
                text: "Inch"
                values: ["Inch", "Millimeter"]
            Label:
                text: "Height:"
                color: 0,0,0,1
            NumInput:
                id: entry_h_cut
            Label:
                text: "Width:"
                color: 0,0,0,1
            NumInput:
                id: entry_w_cut
                
        BoxLayout:
            size_hint_y: None
            height: '55dp'
            padding: [10, 5, 10, 5]
            spacing: '10dp'
            PremiumBtn:
                text: "CLEAR"
                size_hint_x: 0.3
                bg_color: 0.8, 0.2, 0.2, 1
                on_release: root.clear_all()
            PremiumBtn:
                text: "+ CALCULATE"
                size_hint_x: 0.7
                bg_color: 0.1, 0.5, 0.8, 1
                on_release: root.calculate_domal()
                
        BoxLayout:
            size_hint_y: None
            height: '55dp'
            padding: [10, 5, 10, 5]
            spacing: '10dp'

<QuotationScreen>:
    name: 'quotation'
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: '65dp'
            padding: '10dp'
            canvas.before:
                Color:
                    rgba: 0.6, 0.2, 0.6, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, 20, 20]
            Button:
                text: "< Back"
                bold: True
                size_hint_x: 0.25
                background_normal: ''
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: 0.8, 0.1, 0.1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.manager.current = 'home'
            Label:
                text: "PRO QUOTATION"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.75
        ScrollView:
            size_hint: 1, 1
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: '15dp'
                spacing: '15dp'
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.98, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                Label:
                    text: "--- CUSTOMER & BILL DETAILS ---"
                    color: 0.6, 0.2, 0.6, 1
                    bold: True
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: '210dp'
                    spacing: '10dp'
                    Label:
                        text: "Bill Stage:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_stage
                        text: "Quotation / Estimate"
                        values: ["Quotation / Estimate", "First Bill", "Second Bill", "Third Bill", "Final Bill"]
                    Label:
                        text: "Name:"
                        color: 0,0,0,1
                    TextInput:
                        id: q_name
                        multiline: False
                    Label:
                        text: "Phone / PIN:"
                        color: 0,0,0,1
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: '5dp'
                        TextInput:
                            id: q_phone
                            multiline: False
                            input_type: 'number'
                        Button:
                            text: "[font=emoji.ttf]🔍[/font]"
                            markup: True
                            size_hint_x: None
                            width: '45dp'
                            background_color: 0.2, 0.6, 0.8, 1
                            color: 1,1,1,1
                            on_release: root.autofill_customer()
                    Label:
                        text: "Address:"
                        color: 0,0,0,1
                    TextInput:
                        id: q_addr
                        multiline: False
                
                Label:
                    text: "--- ADD BILL ITEM ---"
                    color: 0.6, 0.2, 0.6, 1
                    bold: True
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                
                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: '510dp'  
                    spacing: '8dp'
                    
                    Label:
                        text: "Type:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_type
                        text: "Domal 27x65 (2-Track)"
                        values: ["Domal 27x65 (2-Track)", "Domal 27x65 (3-Track)", "Domal 27x65 (4-Track)", "Domal 35x75 (2-Track)", "Domal 35x75 (3-Track)", "Domal 35x75 (4-Track)", "Sliding 18x40 (2-Track)", "Sliding 18x40 (3-Track)", "Sliding 18x40 (4-Track)", "Sliding 18x50 (2-Track)", "Sliding 18x50 (3-Track)", "Sliding 18x50 (4-Track)", "Sliding 18x60 (2-Track)", "Sliding 18x60 (3-Track)", "Sliding 18x60 (4-Track)", "Sliding 25x50 (2-Track)", "Sliding 25x50 (3-Track)", "Sliding 25x50 (4-Track)", "Sliding 25x65 (2-Track)", "Sliding 25x65 (3-Track)", "Sliding 25x65 (4-Track)", "Casement 34 Series", "Casement 40 Series", "Standard Door", "Floor Spring Door", "Top Hung Door", "Domal Door", "Fixed Partition", "Door Partition", "Gypsum Ceiling", "PVC Ceiling", "Other Work"]
                        on_text: root.update_auto_rate()

                    Label:
                        text: "Room / Location:"
                        color: 0,0,0,1
                    TextInput:
                        id: q_loc
                        multiline: False
                        hint_text: "e.g. Bed-1, Hall, Kitchen"

                    Label:
                        text: "Alu Color:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_color
                        text: "Jet Black"
                        values: ["Jet Black", "Pure White", "Silver Anodized", "Champagne / Bronze", "Chocolate Brown", "Charcoal Grey", "Wooden Finish", "Mill Finish"]
                        on_text: root.update_auto_rate()

                    Label:
                        text: "Thickness:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_thick
                        text: "1.5 mm"
                        values: ["0.8 mm", "1.0 mm", "1.2 mm", "1.5 mm", "1.6 mm", "1.8 mm", "2.0 mm", "2.5 mm", "3.0 mm"]
                        on_text: root.update_auto_rate()

                    Label:
                        text: "Glass Thick:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_g_thick
                        text: "5.0 mm"
                        values: ["3.5 mm", "4.0 mm", "5.0 mm", "6.0 mm", "8.0 mm", "10.0 mm", "12.0 mm", "DGU Soundproof"]
                        on_text: root.update_auto_rate()

                    Label:
                        text: "Glass Type:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_g_type
                        text: "Clear Float"
                        values: ["Clear Float", "Pinhead / Figured", "Frosted / Acid", "Black / Grey Tinted", "Royal Blue Reflective", "Emerald Green Reflective", "Bronze / Gold Reflective"]
                        on_text: root.update_auto_rate()

                    Label:
                        text: "Toughened?:"
                        color: 0,0,0,1
                    Spinner:
                        id: q_tough
                        text: "No"
                        values: ["No", "Yes (Toughened)"]
                        on_text: root.update_auto_rate()

                    Label:
                        text: "Rate (Rs/Sq.Ft):"
                        bold: True
                        color: 0.1, 0.5, 0.2, 1
                    NumInput:
                        id: q_rate
                        text: "400"
                        bold: True

                    Label:
                        text: "Qty:"
                        color: 0,0,0,1
                    NumInput:
                        id: q_qty
                        text: "1"
                        
                    Label:
                        text: "Height:"
                        color: 0,0,0,1
                    NumInput:
                        id: q_h

                    Label:
                        text: "Width:"
                        color: 0,0,0,1
                    NumInput:
                        id: q_w
                        
                BoxLayout:
                    size_hint_y: None
                    height: '55dp'
                    spacing: '10dp'
                    PremiumBtn:
                        text: "CLEAR"
                        size_hint_x: 0.3
                        bg_color: 0.8, 0.2, 0.2, 1
                        on_release: root.clear_items()
                    PremiumBtn:
                        text: "+ ADD ITEM"
                        size_hint_x: 0.7
                        bg_color: 0.1, 0.6, 0.2, 1
                        on_release: root.add_item()
                
                TextInput:
                    id: bill_queue_text
                    readonly: True
                    use_bubble: False
                    use_handles: False
                    size_hint_y: None
                    height: max(self.minimum_height, dp(120))
                    font_size: '12sp'
                    
                BoxLayout:
                    size_hint_y: None
                    height: '40dp'
                    Label:
                        text: "Advance Paid (Rs):"
                        color: 0.6, 0.2, 0.6, 1
                        bold: True
                        size_hint_x: 0.4
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    NumInput:
                        id: q_advance
                        text: "0"
                        size_hint_x: 0.6
                
                BoxLayout:
                    size_hint_y: None
                    height: '40dp'
                    Label:
                        text: "Transport/Labor (Rs):"
                        color: 0.8, 0.4, 0.1, 1
                        bold: True
                        size_hint_x: 0.4
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    NumInput:
                        id: q_extra_charge
                        text: "0"
                        size_hint_x: 0.6
                        
                BoxLayout:
                    size_hint_y: None
                    height: '40dp'
                    Label:
                        text: "Special Note:"
                        color: 0.1, 0.5, 0.8, 1
                        bold: True
                        size_hint_x: 0.4
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    TextInput:
                        id: q_remarks
                        hint_text: "Ex: Balance after fitting"
                        multiline: False
                        size_hint_x: 0.6
                
                BoxLayout:
                    size_hint_y: None
                    height: '55dp'
                    PremiumBtn:
                        text: "GENERATE BILL"
                        bg_color: 0.6, 0.2, 0.6, 1
                        on_release: root.generate_bill()
                
                BoxLayout:
                    size_hint_y: None
                    height: '55dp'
                    spacing: '10dp'
                    PremiumBtn:
                        text: "SAVE BILL"
                        bg_color: 0.2, 0.5, 0.8, 1
                        on_release: root.save_to_db(self)
                    PremiumBtn:
                        text: "PDF BILL"
                        bg_color: 0.8, 0.2, 0.2, 1
                        on_release: root.export_bill_pdf(self)
                    PremiumBtn:
                        text: "[font=emoji.ttf]🟢[/font] WhatsApp"
                        bg_color: 0.1, 0.7, 0.3, 1
                        on_release: root.share_to_whatsapp(self)
                
                TextInput:
                    id: bill_output
                    readonly: True
                    use_bubble: False
                    use_handles: False
                    size_hint_y: None
                    height: max(self.minimum_height, dp(450))
                    font_size: '14sp'
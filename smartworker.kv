<DashboardScreen>:
    name: 'dashboard'
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: '65dp'
            padding: '10dp'
            canvas.before:
                Color:
                    rgba: 0.4, 0.2, 0.6, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, 20, 20]
            Button:
                text: "< Back"
                bold: True
                size_hint_x: 0.25
                background_normal: ''
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: 0.8, 0.1, 0.1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.manager.current = 'settings'
            Label:
                text: "DASHBOARD"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.75
        BoxLayout:
            orientation: 'vertical'
            padding: '10dp'
            spacing: '10dp'
            size_hint_y: None
            height: '140dp'
            BoxLayout:
                size_hint_y: 0.3
                Label:
                    text: "Select Month:"
                    color: 0,0,0,1
                    bold: True
                    size_hint_x: 0.4
                Spinner:
                    id: dash_month
                    text: root.current_month
                    values: [root.current_month]
                    size_hint_x: 0.6
                    on_text: root.load_dashboard()
            BoxLayout:
                size_hint_y: 0.7
                spacing: '5dp'
                DashCard:
                    card_title: 'TOTAL SALES'
                    card_value: root.total_sales
                    bg_color: (0.1, 0.6, 0.2, 1)
                DashCard:
                    card_title: 'PURCHASES'
                    card_value: root.total_purchases
                    bg_color: (0.8, 0.2, 0.2, 1)
                DashCard:
                    card_title: 'BALANCE'
                    card_value: root.net_balance
                    bg_color: (0.1, 0.5, 0.8, 1)
        BoxLayout:
            size_hint_y: None
            height: '55dp'
            padding: [10, 0, 10, 10]
            PremiumBtn:
                text: "+ ADD MATERIAL PURCHASE"
                bg_color: 0.9, 0.5, 0.1, 1
                on_release: root.open_add_expense()
        ScrollView:
            padding: '10dp'
            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.98, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            TextInput:
                id: dash_details
                readonly: True
                use_bubble: False
                use_handles: False
                font_size: '13sp'
                size_hint_y: None
                height: max(self.minimum_height, dp(350))

<ExpensePopup@ModalView>:
    size_hint: 0.9, 0.75
    background_color: 0, 0, 0, 0.7
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: '15dp'
        spacing: '10dp'
        canvas.before:
            Color:
                rgba: 0.95, 0.95, 0.98, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [15]
        Label:
            text: "ADD NEW PURCHASE"
            color: 0.1, 0.2, 0.4, 1
            font_size: '18sp'
            bold: True
            size_hint_y: None
            height: '30dp'
        ScrollView:
            GridLayout:
                cols: 1
                spacing: '10dp'
                size_hint_y: None
                height: self.minimum_height
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.98, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "Material Category:"
                    color: 0,0,0,1
                    size_hint_y: None
                    height: '25dp'
                    text_size: self.size
                    halign: 'left'
                Spinner:
                    id: exp_cat
                    text: "Aluminum Profile"
                    values: ["Aluminum Profile", "Glass / Board", "Hardware & Accessories", "Labor / Transport", "Other"]
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "Shop / Supplier Name:"
                    color: 0,0,0,1
                    size_hint_y: None
                    height: '25dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: exp_supplier
                    multiline: False
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "Bill No / Memo Ref:"
                    color: 0,0,0,1
                    size_hint_y: None

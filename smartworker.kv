<PremiumBtn@Button>:
    markup: True
    font_size: '16sp'
    bold: True
    color: 1, 1, 1, 1
    background_normal: ''
    background_color: 0, 0, 0, 0  
    text_size: self.size
    halign: 'center'
    valign: 'middle'
    canvas.before:
        Color:
            rgba: self.bg_color if hasattr(self, 'bg_color') else (0.2, 0.5, 0.8, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

<MenuCard@Button>:
    markup: True
    background_normal: ''
    background_color: 0, 0, 0, 0
    bg_color: 0.2, 0.5, 0.8, 1
    title: ''
    icon: ''
    text: '[font=emoji.ttf][size=32sp]' + self.icon + '[/size][/font]\n[size=13sp][b]' + self.title + '[/b][/size]'
    text_size: self.size
    halign: 'center'
    valign: 'middle'
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: self.bg_color if hasattr(self, 'bg_color') else (0.2, 0.5, 0.8, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15]

<NavBtn@Button>:
    markup: True
    background_normal: ''
    background_color: 0, 0, 0, 0
    title: ''
    icon: ''
    text_color: 0.4, 0.4, 0.4, 1
    color: self.text_color
    text: '[font=emoji.ttf][size=22sp]' + self.icon + '[/size][/font]\n[size=11sp][b]' + self.title + '[/b][/size]'
    text_size: self.size
    halign: 'center'
    valign: 'middle'

<DashCard@BoxLayout>:
    orientation: 'vertical'
    padding: '10dp'
    spacing: '5dp'
    card_title: ''
    card_value: ''
    bg_color: (0.9, 0.9, 0.9, 1)
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]
    Label:
        text: root.card_title
        color: 1,1,1,1
        bold: True
        font_size: '14sp'
        size_hint_y: 0.4
    Label:
        text: root.card_value
        color: 1,1,1,1
        bold: True
        font_size: '18sp'
        size_hint_y: 0.6

<NumInput@Button>:
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: 0, 0, 0, 1
    halign: 'left'
    valign: 'middle'
    text_size: self.width - 20, self.height
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: 0.7, 0.7, 0.7, 1
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
            width: 1
    on_release: app.open_keypad(self)

<CalcBtn@Button>:
    font_size: '22sp'
    background_normal: ''
    background_color: 0.85, 0.85, 0.85, 1
    color: 0, 0, 0, 1
    bold: True
    canvas.before:
        Color:
            rgba: 0.5, 0.5, 0.5, 1
        Line:
            width: 1
            rectangle: (self.x, self.y, self.width, self.height)

<KeypadPopup>:
    size_hint: 0.95, 0.95
    background_color: 0, 0, 0, 0.8
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: '5dp'
        spacing: '5dp'
        canvas.before:
            Color:
                rgba: 0.9, 0.9, 0.92, 1
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: 0.15
            spacing: '5dp'
            Label:
                text: root.display_text
                color: 0.2, 0.4, 0.4, 1
                font_size: '34sp'
                text_size: self.width - 20, self.height
                halign: 'right'
                valign: 'middle'
            Button:
                text: 'OK'
                size_hint_x: 0.2
                background_color: 0, 0.7, 0, 1
                color: 1, 1, 1, 1
                font_size: '20sp'
                bold: True
                on_release: root.enter()
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.75
            spacing: '5dp'
            GridLayout:
                cols: 2
                size_hint_x: 0.4
                spacing: '3dp'
                CalcBtn:
                    text: 'C'
                    color: 1, 0, 0, 1
                    background_color: 1, 0.6, 0.6, 1
                    on_release: root.clear()
                CalcBtn:
                    text: '<'
                    background_color: 0.7, 0.7, 0.8, 1
                    on_release: root.backspace()
                CalcBtn:
                    text: '1'
                    on_release: root.add_whole('1')
                CalcBtn:
                    text: '2'
                    on_release: root.add_whole('2')
                CalcBtn:
                    text: '3'
                    on_release: root.add_whole('3')
                CalcBtn:
                    text: '4'
                    on_release: root.add_whole('4')
                CalcBtn:
                    text: '5'
                    on_release: root.add_whole('5')
                CalcBtn:
                    text: '6'
                    on_release: root.add_whole('6')
                CalcBtn:
                    text: '7'
                    on_release: root.add_whole('7')
                CalcBtn:
                    text: '8'
                    on_release: root.add_whole('8')
                CalcBtn:
                    text: '9'
                    on_release: root.add_whole('9')
                CalcBtn:
                    text: '0'
                    on_release: root.add_whole('0')
                CalcBtn:
                    text: '.'
                    on_release: root.add_whole('.')
                CalcBtn:
                    text: '+/-'
                    on_release: root.add_whole('-')
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.6
                spacing: '5dp'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: '3dp'
                    GridLayout:
                        cols: 3
                        spacing: '3dp'
                        CalcBtn:
                            text: '1'
                            on_release: root.add_num('1')
                        CalcBtn:
                            text: '2'
                            on_release: root.add_num('2')
                        CalcBtn:
                            text: '3'
                            on_release: root.add_num('3')
                        CalcBtn:
                            text: '4'
                            on_release: root.add_num('4')
                        CalcBtn:
                            text: '5'
                            on_release: root.add_num('5')
                        CalcBtn:
                            text: '6'
                            on_release: root.add_num('6')
                        CalcBtn:
                            text: '7'
                            on_release: root.add_num('7')
                        CalcBtn:
                            text: '8'
                            on_release: root.add_num('8')
                        CalcBtn:
                            text: '9'
                            on_release: root.add_num('9')
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: 0.33 
                        spacing: '3dp'
                        CalcBtn:
                            text: '0'
                            size_hint_x: 0.66
                            on_release: root.add_num('0')
                        CalcBtn:
                            text: '<'
                            background_color: 0.7, 0.7, 0.8, 1
                            size_hint_x: 0.34
                            on_release: root.backspace()
                Widget:
                    size_hint_y: None
                    height: '4dp'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: '3dp'
                    GridLayout:
                        cols: 3
                        spacing: '3dp'
                        CalcBtn:
                            text: '1'
                            on_release: root.add_denom('1')
                        CalcBtn:
                            text: '2'
                            on_release: root.add_denom('2')
                        CalcBtn:
                            text: '3'
                            on_release: root.add_denom('3')
                        CalcBtn:
                            text: '4'
                            on_release: root.add_denom('4')
                        CalcBtn:
                            text: '5'
                            on_release: root.add_denom('5')
                        CalcBtn:
                            text: '6'
                            on_release: root.add_denom('6')
                        CalcBtn:
                            text: '7'
                            on_release: root.add_denom('7')
                        CalcBtn:
                            text: '8'
                            on_release: root.add_denom('8')
                        CalcBtn:
                            text: '9'
                            on_release: root.add_denom('9')
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: 0.33
                        spacing: '3dp'
                        CalcBtn:
                            text: '0'
                            size_hint_x: 0.66
                            on_release: root.add_denom('0')
                        CalcBtn:
                            text: '<'
                            background_color: 0.7, 0.7, 0.8, 1
                            size_hint_x: 0.34
                            on_release: root.backspace()
        GridLayout:
            cols: 5
            size_hint_y: 0.15
            spacing: '3dp'
            CalcBtn:
                text: '+'
                background_color: 0.7, 0.7, 0.8, 1
                on_release: root.add_whole('+')
            CalcBtn:
                text: '-'
                background_color: 0.7, 0.7, 0.8, 1
                on_release: root.add_whole('-')
            CalcBtn:
                text: '*'
                background_color: 0.7, 0.7, 0.8, 1
                on_release: root.add_whole('*')
            CalcBtn:
                text: '/'
                background_color: 0.7, 0.7, 0.8, 1
                on_release: root.add_whole('/')
            CalcBtn:
                text: '='
                background_color: 1, 0.6, 0.2, 1
                on_release: root.calculate_result()

ScreenManager:
    SplashScreen:
    ActivationScreen:
    SetupScreen:
    HomeScreen:
    SettingsScreen:
    ProfileScreen:
    HistoryScreen:
    CustomerLookupScreen:
    DashboardScreen:
    BillSettingsScreen:
    DomalScreen:
    SlidingScreen:
    CustomCasementScreen:
    DoorScreen:
    PartitionScreen:      
    QuotationScreen:
    CeilingScreen:

<SplashScreen>:
    name: 'splash'
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.24, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: '30dp'
        spacing: '15dp'
        Widget:
            size_hint_y: 0.25
        Label:
            text: "[font=emoji.ttf][size=54sp]🪟[/size][/font]"
            markup: True
            size_hint_y: None
            height: '70dp'
        Label:
            text: "SMART WORKER PRO"
            font_size: '28sp'
            bold: True
            color: 1, 0.82, 0.15, 1
            size_hint_y: None
            height: '45dp'
        Label:
            text: "Aluminium & Glass Fabrication Management"
            font_size: '14sp'
            color: 0.8, 0.88, 1, 1
            size_hint_y: None
            height: '25dp'
        Widget:
            size_hint_y: 0.35
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '55dp'
            spacing: '6dp'
            Label:
                text: "[font=emoji.ttf]⚙️[/font] Loading System... Please Wait"
                markup: True
                font_size: '14sp'
                bold: True
                color: 0.6, 0.8, 1, 1
            Label:
                text: "Smart Worker Aluminium • Amta"
                font_size: '12sp'
                color: 0.45, 0.6, 0.75, 1
        Widget:
            size_hint_y: 0.15

<ActivationScreen>:
    name: 'activation'
    BoxLayout:
        orientation: 'vertical'
        padding: '25dp'
        spacing: '15dp'
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.15, 1
            Rectangle:
                pos: self.pos
                size: self.size
                
        BoxLayout:
            size_hint_y: None
            height: '50dp'
            Button:
                text: "< BACK"
                bold: True
                color: 1, 1, 1, 1
                background_normal: ''
                background_color: 0, 0, 0, 0
                size_hint_x: 0.3
                canvas.before:
                    Color:
                        rgba: 0.8, 0.2, 0.2, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.manager.current = 'home'
            Label:
                text: "PRO UPGRADE"
                font_size: '22sp'
                bold: True
                color: 0.9, 0.7, 0.1, 1
                size_hint_x: 0.7
                
        Label:
            text: "Unlock PDF Billing, Quotations & Premium Features!\nClick the WhatsApp button below to get Key:"
            font_size: '15sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: '60dp'
            
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '50dp'
            spacing: '10dp'
            Label:
                text: "Device ID:"
                bold: True
                size_hint_x: 0.3
            TextInput:
                text: root.device_id_text
                readonly: True
                font_size: '18sp'
                multiline: False
                size_hint_x: 0.7

        Button:
            text: "[font=emoji.ttf]💬[/font] SEND DEVICE ID TO WHATSAPP (9239413517)"
            markup: True
            font_size: '14sp'
            bold: True
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            size_hint_y: None
            height: '60dp'
            canvas.before:
                Color:
                    rgba: 0.15, 0.7, 0.3, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]
            on_release: root.subscribe_via_whatsapp()
                
        TextInput:
            id: activation_input
            hint_text: "Enter Pro Activation Key"
            font_size: '18sp'
            multiline: False
            size_hint_y: None
            height: '50dp'
            
        Button:
            text: "ACTIVATE PRO"
            bold: True
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            size_hint_y: None
            height: '55dp'
            canvas.before:
                Color:
                    rgba: 0.1, 0.5, 0.8, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]
            on_release: root.activate_app()
            
        Widget:

<SetupScreen>:
    name: 'setup'
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: '20dp'
        spacing: '10dp'
        Label:
            text: "WELCOME TO SMART WORKER PRO"
            color: 0.1, 0.2, 0.4, 1
            font_size: '22sp'
            bold: True
            size_hint_y: None
            height: '40dp'
        Label:
            text: "Please set up your profile to generate bills in your Shop's name."
            color: 0.3, 0.3, 0.3, 1
            font_size: '14sp'
            size_hint_y: None
            height: '30dp'
        ScrollView:
            GridLayout:
                cols: 1
                spacing: '10dp'
                size_hint_y: None
                height: self.minimum_height
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.98, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "Your Name (Required):"
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: setup_name
                    multiline: False
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "Shop / Company Name (Required):"
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: setup_shop
                    multiline: False
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "Phone Number (Required):"
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: setup_phone
                    multiline: False
                    input_type: 'number'
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "Email / Gmail ID (Optional):"
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: setup_email
                    multiline: False
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "GST Number (Optional):"
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: setup_gst
                    multiline: False
                    size_hint_y: None
                    height: '40dp'
                Label:
                    text: "Shop Address (Required):"
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: '30dp'
                    text_size: self.size
                    halign: 'left'
                TextInput:
                    id: setup_address
                    multiline: True
                    size_hint_y: None
                    height: '80dp'
        PremiumBtn:
            text: "SAVE & CONTINUE"
            size_hint_y: None
            height: '55dp'
            bg_color: 0.1, 0.6, 0.2, 1
            on_release: root.save_profile()

<HomeScreen>:
    name: 'home'
    canvas.before:
        Color:
            rgba: 0.94, 0.96, 0.98, 1  
        Rectangle:
            pos: self.pos
            size: self.size
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            BoxLayout:
                size_hint_y: None
                height: '110dp'
                padding: ['20dp', '30dp', '20dp', '15dp']
                canvas.before:
                    Color:
                        rgba: 0.15, 0.25, 0.45, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [0, 0, 25, 25]
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: root.greeting
                        font_size: '14sp'
                        color: 0.7, 0.8, 1, 1
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        text: root.shop_name_display
                        font_size: '20sp'
                        bold: True
                        color: 1, 1, 1, 1
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                Button:
                    size_hint_x: None
                    width: '40dp'
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    text: "[font=emoji.ttf]⚙️[/font]"
                    markup: True
                    font_size: '24sp'
                    on_release: root.manager.current = 'settings'
            
            ScrollView:
                BoxLayout:
                    orientation: 'vertical'
                    padding: '20dp'
                    spacing: '20dp'
                    size_hint_y: None
                    height: self.minimum_height
                    canvas.before:
                        Color:
                            rgba: 0.94, 0.96, 0.98, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    
                    Label:
                        text: "FABRICATION SYSTEMS"
                        color: 0.5, 0.5, 0.6, 1
                        font_size: '13sp'
                        bold: True
                        size_hint_y: None
                        height: '25dp'
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                        
                    GridLayout:
                        cols: 2
                        spacing: '15dp'
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: '130dp'
                        row_force_default: True
                        MenuCard:
                            icon: "🪟"
                            title: "Domal Window"
                            bg_color: 0.1, 0.5, 0.8, 1 
                            on_release: root.manager.current = 'domal'
                        MenuCard:
                            icon: "🪟"
                            title: "Sliding Window"
                            bg_color: 0.8, 0.4, 0.1, 1 
                            on_release: root.manager.current = 'slidingscreen'
                        MenuCard:
                            icon: "🪟"
                            title: "Custom Casement"
                            bg_color: 0.8, 0.2, 0.4, 1 
                            on_release: root.manager.current = 'custom_casement'
                        MenuCard:
                            icon: "🚪"
                            title: "Partition & Door"
                            bg_color: 0.9, 0.3, 0.3, 1 
                            on_release: root.manager.current = 'partition'
                            
                    MenuCard:
                        size_hint_y: None
                        height: '100dp'
                        icon: "🚪"
                        title: "Simple Door Option"
                        bg_color: 0.7, 0.3, 0.1, 1 
                        on_release: root.manager.current = 'door'
                        
                    Label:
                        text: "BUSINESS & BILLING"
                        color: 0.5, 0.5, 0.6, 1
                        font_size: '13sp'
                        bold: True
                        size_hint_y: None
                        height: '25dp'
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                        
                    GridLayout:
                        cols: 2
                        spacing: '15dp'
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: '130dp'
                        row_force_default: True
                        MenuCard:
                            icon: "🧾"
                            title: "Pro Quotation"
                            bg_color: 0.6, 0.2, 0.6, 1 
                            on_release: root.manager.current = 'quotation'
                        MenuCard:
                            icon: "📏"
                            title: "Ceiling Estimator"
                            bg_color: 0.1, 0.7, 0.7, 1 
                            on_release: root.manager.current = 'ceiling'
                            
                    Widget:
                        size_hint_y: None
                        height: '20dp' 

            BoxLayout:
                size_hint_y: None
                height: '60dp'
                padding: '5dp'
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20, 20, 0, 0]
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    Line:
                        points: [self.x, self.top, self.right, self.top]
                        width: 1
                NavBtn:
                    icon: "🏠"
                    title: "Home"
                    text_color: 0.2, 0.5, 0.8, 1 
                    on_release: root.manager.current = 'home'
                NavBtn:
                    icon: "📊"
                    title: "Dashboard"
                    text_color: 0.4, 0.4, 0.4, 1
                    on_release: root.manager.current = 'dashboard'
                NavBtn:
                    icon: "🗂️"
                    title: "Records"
                    text_color: 0.4, 0.4, 0.4, 1
                    on_release: root.manager.current = 'history'
                NavBtn:
                    icon: "👤"
                    title: "Profile"
                    text_color: 0.4, 0.4, 0.4, 1
                    on_release: root.manager.current = 'profile'
        
        Button:
            size_hint: None, None
            size: '65dp', '65dp'
            pos_hint: {'right': 0.92, 'y': 0.16}
            background_normal: ''
            background_color: 0, 0, 0, 0
            text: "[font=emoji.ttf]➕[/font]"
            markup: True
            font_size: '28sp'
            bold: True
            color: 1, 1, 1, 1
            on_release: root.manager.current = 'quotation'
            canvas.before:
                Color:
                    rgba: 0.9, 0.2, 0.4, 1 
                Ellipse:
                    pos: self.pos
                    size: self.size

<SettingsScreen>:
    name: 'settings'
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: '65dp'
            padding: '10dp'
            canvas.before:
                Color:
                    rgba: 0.1, 0.2, 0.4, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, 20, 20]
            Button:
                text: "< Back"
                bold: True
                size_hint_x: 0.25
                background_normal: ''
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: 0.8, 0.1, 0.1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.manager.current = 'home'
            Label:
                text: "SETTINGS"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.75
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: '30dp'
                spacing: '20dp'
                size_hint_y: None
                height: self.minimum_height
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.98, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                PremiumBtn:
                    text: "[font=emoji.ttf]🔒[/font] Privacy Policy & Terms"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.3, 0.4, 0.5, 1
                    on_release: app.open_privacy_policy()

                PremiumBtn:
                    text: "[font=emoji.ttf]⭐[/font] PRO Subscription / Activation"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.2, 0.6, 0.3, 1
                    on_release: root.manager.current = 'activation'

                PremiumBtn:
                    text: "[font=emoji.ttf]👤[/font] Edit Profile"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.2, 0.5, 0.8, 1
                    on_release: root.manager.current = 'profile'
                
                PremiumBtn:
                    text: "[font=emoji.ttf]⚙️[/font] Dynamic Costing & Bill Setup"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.6, 0.4, 0.2, 1
                    on_release: root.manager.current = 'bill_settings'
                    
                PremiumBtn:
                    text: "[font=emoji.ttf]🗂️[/font] Data History"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.3, 0.3, 0.4, 1
                    on_release: root.manager.current = 'history'
                PremiumBtn:
                    text: "[font=emoji.ttf]🔒[/font] Customer Book (PIN)"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.8, 0.4, 0.1, 1
                    on_release: root.manager.current = 'customer_lookup'
                PremiumBtn:
                    text: "[font=emoji.ttf]📊[/font] Business Dashboard"
                    size_hint_y: None
                    height: '65dp'
                    bg_color: 0.4, 0.2, 0.6, 1
                    on_release: root.manager.current = 'dashboard'

<BillSettingsScreen>:
    name: 'bill_settings'
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: '65dp'
            padding: '10dp'
            canvas.before:
                Color:
                    rgba: 0.6, 0.4, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, 20, 20]
            Button:
                text: "< Back"
                bold: True
                size_hint_x: 0.25
                background_normal: ''
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: 0.8, 0.1, 0.1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.manager.current = 'settings'
            Label:
                text: "DYNAMIC COSTING & BILL SETUP"
                font_size: '18sp'
                bold: True
                size_hint_x: 0.75
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: '15dp'
                spacing: '15dp'
                size_hint_y: None
                height: self.minimum_height
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.98, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                Label:
                    text: "--- GENERAL SETTINGS ---"
                    color: 0.8, 0.2, 0.2, 1
                    bold: True
                    size_hint_y: None
                    height: '30dp'
                GridLayout:
                    cols: 2
                    spacing: '10dp'
                    size_hint_y: None
                    height: '140dp'
                    Label:
                        text: "Default Unit:"
                        color: 0,0,0,1
                    Spinner:
                        id: bs_unit
                        values: ["Feet", "Inches", "Millimeters"]
                    Label:
                        text: "Default GST (%):"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_gst
                    Label:
                        text: "Default Discount (Rs):"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_discount

                Label:
                    text: "=== DYNAMIC COSTING ENGINE SETUP ==="
                    color: 0.1, 0.6, 0.2, 1
                    bold: True
                    font_size: '15sp'
                    size_hint_y: None
                    height: '35dp'

                # STEP 1: SLIDING WINDOW & ALL ITS COLOR VARIANTS
                Label:
                    text: "--- STEP 1: SLIDING 18x40 & COLOR VARIANTS (Rs/Kg) ---"
                    color: 0.1, 0.6, 0.2, 1
                    bold: True
                    size_hint_y: None
                    height: '30dp'
                GridLayout:
                    cols: 2
                    spacing: '10dp'
                    size_hint_y: None
                    height: '170dp'
                    Label:
                        text: "Sliding Mill/Natural (Base):"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_sl_mill
                        text: "260"
                    Label:
                        text: "Sliding Silver Anodized:"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_sl_anod
                        text: "275"
                    Label:
                        text: "Sliding Powder Coated:"
                        color: 0,0,0,1
                    NumInput:
                        id: bs_sl_powder
                        text: "290"
                    Label:
                        text: "Sliding Wooden Finish:"
                        bold: True
                        color: 0.8, 0.4, 0.1, 1
                    NumInput:
                        id: bs_sl_wooden
                        text: "345"

                # STEP 2: DOMAL WINDOW & ALL ITS COLOR VARIANTS
                Label:
                    text: "--- STEP 2: DOMAL SYSTEM & COLOR VARIANTS (Rs/Kg) ---"
                    color: 0.1, 0.4, 0.8, 1
                    bold: True
                    size_hint_y: None
                    height: '30dp'
                GridLayout:
                    cols: 2
                    spacing: '10dp'
                    size_hint_y: None
                    height: '170dp'
                    Label:
